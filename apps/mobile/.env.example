# Copy to .env for local development only (`npx expo start`). Never commit .env.
# Production APKs get this value from eas.json / EAS environment variables at build time.

# The website the WebView loads. For local testing on a phone, use your computer's LAN
# address (e.g. http://192.168.1.20:5173) — never ship an APK built with such a URL.
EXPO_PUBLIC_WEB_URL=https://your-website.example.com
