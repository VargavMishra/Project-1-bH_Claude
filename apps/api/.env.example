# API environment variables. Copy to apps/api/.env for local development.
# .env is git-ignored. In production these are set in the Render dashboard, never in Git.
# Placeholders only — no real values in this file.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Comma-separated list of website origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173

# Added in Stage 4 (Supabase): project URL and PUBLIC publishable key only.
# The API forwards each user's own JWT, so it does not need the secret/service-role key.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_<placeholder>
