# Integration-test settings. Copy to apps/api/.env.test (git-ignored) and fill in values
# from the DEVELOPMENT project only (profilesync-dev):
#   Supabase dashboard → Project Settings → API Keys, and the project URL from "Connect".
#
# The secret key is used ONLY by the tests, to create and delete throwaway test users.
# The API itself never needs it. Never use the production project's keys here.

SUPABASE_URL=https://<dev-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<placeholder>
SUPABASE_SECRET_KEY=sb_secret_<placeholder>
