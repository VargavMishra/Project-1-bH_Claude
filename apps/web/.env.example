# Website build-time variables. Copy to apps/web/.env.local for local development.
# Every VITE_* value is embedded in the PUBLIC JavaScript bundle: never put secrets here.
# In production these are set in the Render static-site dashboard.

VITE_API_URL=http://localhost:4000

# Added in Stage 5 (Supabase Auth): project URL and publishable (public) key.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<placeholder>
